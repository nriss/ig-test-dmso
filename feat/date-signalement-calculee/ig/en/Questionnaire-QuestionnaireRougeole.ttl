  fhir:Questionnaire.item [
     fhir:index -1 ;
     fhir:Questionnaire.item.linkId [ fhir:value "entete" ] ;
     fhir:Questionnaire.item.text [ fhir:value "Rougeole - cerfa n° 12554*04 du 22/04/2026" ] ;
     fhir:Questionnaire.item.type [ fhir:value "group" ] ;
     fhir:Questionnaire.item.item [
       fhir:index -1 ;
       fhir:Questionnaire.item.linkId [ fhir:value "entete-definition-cas" ] ;
       fhir:Questionnaire.item.text [
         fhir:value "Définition de cas : Cas clinique : fièvre ≥38,5 °C associée à une éruption maculo-papuleuse et à au moins un des signes suivants : conjonctivite, coryza, toux, signe de Köplik. Cas confirmé : - confirmation biologique (détection d'IgM spécifiques (i) dans la salive ou le sérum et/ou séroconversion ou élévation de quatre fois au moins du titre des IgG (i) et/ou PCR positive et/ou culture positive) Ou - cas clinique ayant été en contact dans les 7 à 18 jours avant le début de l'éruption avec un cas confirmé. (i) en l'absence de vaccination récente" ;
         fhir:Element.extension [
           fhir:index -1 ;
           fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/rendering-xhtml" ] ;
           fhir:Extension.valueString [ fhir:value "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><b>Définition de cas :</b></p><p><b>Cas clinique</b> : fièvre ≥38,5 °C associée à une éruption maculo-papuleuse et à au moins un des signes suivants : conjonctivite, coryza, toux, signe de Köplik.</p><p><b>Cas confirmé :</b></p><ul><li>confirmation biologique (détection d'IgM spécifiques<sup>(i)</sup> dans la salive ou le sérum et/ou séroconversion ou élévation de quatre fois au moins du titre des IgG<sup>(i)</sup> et/ou PCR positive et/ou culture positive)</li></ul><p><b>Ou</b></p><ul><li>cas clinique ayant été en contact dans les 7 à 18 jours avant le début de l'éruption avec un cas confirmé.</li></ul><p><sup>(i)</sup> en l'absence de vaccination récente</p></div>" ]
         ]
       ] ;
       fhir:Questionnaire.item.type [ fhir:value "display" ]
     ], [
       fhir:index -1 ;
       fhir:Questionnaire.item.linkId [ fhir:value "entete-important" ] ;
       fhir:Questionnaire.item.text [
         fhir:value "Important : cette maladie peut justifier une intervention urgente locale, nationale ou internationale. Tout cas répondant aux critères de signalement doit être signalé immédiatement, sans attendre une confirmation biologique, par tout moyen approprié (téléphone, télécopie, email…) aux personnels habilités de l'agence régionale de santé. Cette maladie visant à être éliminée en France, toute forme clinique doit bénéficier d'une confirmation biologique" ;
         fhir:Element.extension [
           fhir:index -1 ;
           fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/rendering-xhtml" ] ;
           fhir:Extension.valueString [ fhir:value "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><b>Important :</b> cette maladie peut justifier une intervention urgente locale, nationale ou internationale. Tout cas répondant aux critères de signalement doit être signalé immédiatement, sans attendre une confirmation biologique, par tout moyen approprié (téléphone, télécopie, email…) aux personnels habilités de l'agence régionale de santé. <b>Cette maladie visant à être éliminée en France, toute forme clinique doit bénéficier d'une confirmation biologique</b></p></div>" ]
         ]
       ] ;
       fhir:Questionnaire.item.type [ fhir:value "display" ]
     ]
